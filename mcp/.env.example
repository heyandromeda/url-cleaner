# HTTP mode only. Generate with: openssl rand -hex 32   (never commit the real value)
MCP_AUTH_TOKEN=
HOST=127.0.0.1
PORT=8787
# Optional: comma-separated full origins allowed on POST /mcp (default: localhost, 127.0.0.1, [::1] on any port)
# MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8787
# Optional: override engine location (default is repo root, one level up from mcp/)
# ENGINE_DIR=..
