# HTTP mode only. Generate with: openssl rand -hex 32   (never commit the real value)
MCP_AUTH_TOKEN=
HOST=127.0.0.1
PORT=8787
# Optional: comma-separated full origins (scheme+host+port) for POST /mcp; loopback on any port is always allowed
# MCP_ALLOWED_ORIGINS=https://app.example:8443,http://localhost:3000
# Optional: extra Host header values (literal match); include :port when PORT is not 80.
# Loopback names are already allowed when HOST is 127.0.0.1 or a wildcard (0.0.0.0 / ::).
# MCP_ALLOWED_HOSTS=mcp.example.com
# Optional: override engine location (default is repo root, one level up from mcp/)
# ENGINE_DIR=..
