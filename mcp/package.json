{
  "name": "url-cleaner-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for heyandromeda/url-cleaner. Calls the real engine; zero dependencies.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "url-cleaner-mcp": "server.mjs" },
  "scripts": {
